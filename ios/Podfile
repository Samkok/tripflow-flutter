# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # On CI (Codemagic sets CI=true / CM_BUILD_ID) the app is signed with a
  # MANUAL App Store distribution profile via `xcode-project use-profiles`.
  # The automatic + "Apple Development" overrides below run during `pod install`
  # (which happens after use-profiles) and would force the Pods back to
  # development signing — making the archive fail with
  # "No iOS Development certificate / No Accounts". So skip them on CI.
  # Local device builds keep them so they sign automatically with no setup.
  on_ci = ENV['CI'] == 'true' || !ENV['CM_BUILD_ID'].nil?

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      next if on_ci
      # Code signing settings for frameworks (local device builds only)
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'YES'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'
      config.build_settings['CODE_SIGN_IDENTITY'] = 'Apple Development'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
    end
  end

  # Preserve development team + automatic signing in the generated projects
  # (local device builds only — CI relies on manual App Store signing).
  unless on_ci
    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |config|
          if config.build_settings['DEVELOPMENT_TEAM'].nil? || config.build_settings['DEVELOPMENT_TEAM'].empty?
            config.build_settings['DEVELOPMENT_TEAM'] = ENV['DEVELOPMENT_TEAM'] || 'J57YQ6F7J9'
          end
          config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
        end
      end
    end
  end
end
