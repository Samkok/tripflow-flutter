# Copy to `.env` and fill in real values.
# This file MUST NOT be committed (gitignored — see .gitignore).
# All values below ship inside the app binary, so the back-end MUST enforce
# authorization (Supabase RLS, Google Cloud key restrictions, etc.).

# Google API Keys (restrict by app fingerprint + bundle id in Google Cloud Console)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# Supabase (anon key is public-by-design, but RLS policies must be tight)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RevenueCat (public SDK keys — fine to ship in the app)
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# DO NOT put server-side secrets here. The webhook signing key
# (REVENUECAT_WEBHOOK_AUTH_KEY) belongs only on your backend, never in the app.

DEVELOPMENT_TEAM=
