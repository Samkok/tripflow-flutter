<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- gal (save route card to gallery): only needed on Android 10 and below -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Advertising ID: pulled in transitively by firebase_analytics and USED
         for Firebase Analytics + ads attribution (Google Ads conversions).
         Declared explicitly so intent is clear. Because this is present, you
         MUST declare advertising-ID collection in the Play "Data safety" form.
         To OPT OUT instead, replace this line with:
         <uses-permission android:name="com.google.android.gms.permission.AD_ID"
             tools:node="remove" /> (and add xmlns:tools to <manifest>). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Meta's SDK declares Android's Privacy Sandbox permissions. Two of
         them go beyond measuring our own ads (ad audiences kept on the
         device, and the person's interest topics), which the privacy policy
         does not describe, so they are taken out. The attribution and ad-ID
         ones stay: they are ads measurement. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <supports-screens android:smallScreens="true"
                        android:normalScreens="true"
                        android:largeScreens="true"
                        android:xlargeScreens="true"/>

    <application
        android:label="VoyZa"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:supportsRtl">
        <!-- tools:replace: Meta's SDK declares supportsRtl="true" in its own
             manifest; this app's value above wins. -->
        
        <!-- Renderer: Skia, NOT Impeller (Flutter's Android default since 3.38).
             Measured on a OnePlus 7 Pro (Adreno 640, Android 12, 1440x3120 @90Hz):
             Impeller's Vulkan backend held ~333 MB of graphics memory and then
             died allocating a multisample render target —
               "Unable to allocate Vulkan Image: ErrorOutOfDeviceMemory
                Type: Texture2DMultisample" → FATAL back_texture check → SIGABRT.
             The app's glass/blur surfaces (BackdropFilter) each force a
             full-screen MSAA offscreen, which at QHD+ is ~70 MB apiece.
             Skia renders the same UI without the multisample allocations.
             iOS is unaffected (Impeller there is mature and stays on).
             Re-evaluate when Flutter's Android Impeller memory story improves;
             flip the value to "true" and re-run the device test to check. -->
        <meta-data android:name="io.flutter.embedding.android.EnableImpeller"
                   android:value="false" />

        <!-- Google Maps API Key -->
        <meta-data android:name="com.google.android.geo.API_KEY"
                   android:value="${googleMapsApiKey}"/>

        <!-- Meta's SDK (ads measurement). It does NOT start with the app:
             the provider that would start it at launch is removed below, and
             MetaAdsBridge starts it only once the person has allowed ads
             measurement. Until then it makes no request and stores nothing.
             The three "false" values are the SDK's own off switches, so that
             even once started it does nothing the app did not ask for; the
             bridge turns the first two on when measurement is allowed.
             AutoLogMetaData (screen titles and opened links, in newer SDK
             versions) stays off for good. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId"
                   android:value="@string/facebook_app_id" />
        <meta-data android:name="com.facebook.sdk.ClientToken"
                   android:value="@string/facebook_client_token" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
                   android:value="false" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
                   android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogMetaDataEnabled"
                   android:value="false" />
        <!-- Firebase Analytics and Performance start OFF and with every Consent
             Mode signal denied; the consent services switch them on once the
             person's choice is known (see Info.plist for the iOS twin). -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_performance_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustNothing"
            android:largeHeap="true">
            
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voyza" android:host="reset-password" />
            </intent-filter>
            <!-- Trip links. voyza://copy/<CODE> is what the web page behind a
                 shared link hands to the app; the copy wizard opens with the
                 code filled in (lib/services/trip_link_service.dart). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voyza" android:host="copy" />
            </intent-filter>
            <!-- The shared address itself, https://voyza.xtremon.com/c/<CODE>.
                 Android opens it in the app directly once the site serves
                 /.well-known/assetlinks.json with this app's signing
                 fingerprints; until then the link opens the web page, whose
                 button uses the voyza:// form above. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="voyza.xtremon.com"
                      android:pathPrefix="/c/" />
            </intent-filter>
            <!-- Links are read by app_links (supabase_flutter's sign-in
                 callbacks and the trip links above). Flutter's own handler
                 would ALSO push each link onto the navigator as a route
                 name, and this app has no such routes. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        
        <!-- FCM default notification channel (Android 8+) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="voyza_notifications" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="grab" />
        </intent>
    </queries>
</manifest>