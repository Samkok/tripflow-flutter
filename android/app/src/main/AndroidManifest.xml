<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- gal (save route card to gallery): only needed on Android 10 and below -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Advertising ID: pulled in transitively by firebase_analytics and USED
         for Firebase Analytics + ads attribution (Google Ads conversions).
         Declared explicitly so intent is clear. Because this is present, you
         MUST declare advertising-ID collection in the Play "Data safety" form.
         To OPT OUT instead, replace this line with:
         <uses-permission android:name="com.google.android.gms.permission.AD_ID"
             tools:node="remove" /> (and add xmlns:tools to <manifest>). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <supports-screens android:smallScreens="true"
                        android:normalScreens="true"
                        android:largeScreens="true"
                        android:xlargeScreens="true"/>

    <application
        android:label="VoyZa"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true">
        
        <!-- Renderer: Skia, NOT Impeller (Flutter's Android default since 3.38).
             Measured on a OnePlus 7 Pro (Adreno 640, Android 12, 1440x3120 @90Hz):
             Impeller's Vulkan backend held ~333 MB of graphics memory and then
             died allocating a multisample render target —
               "Unable to allocate Vulkan Image: ErrorOutOfDeviceMemory
                Type: Texture2DMultisample" → FATAL back_texture check → SIGABRT.
             The app's glass/blur surfaces (BackdropFilter) each force a
             full-screen MSAA offscreen, which at QHD+ is ~70 MB apiece.
             Skia renders the same UI without the multisample allocations.
             iOS is unaffected (Impeller there is mature and stays on).
             Re-evaluate when Flutter's Android Impeller memory story improves;
             flip the value to "true" and re-run the device test to check. -->
        <meta-data android:name="io.flutter.embedding.android.EnableImpeller"
                   android:value="false" />

        <!-- Google Maps API Key -->
        <meta-data android:name="com.google.android.geo.API_KEY"
                   android:value="${googleMapsApiKey}"/>
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustNothing"
            android:largeHeap="true">
            
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voyza" android:host="reset-password" />
            </intent-filter>
        </activity>
        
        <!-- FCM default notification channel (Android 8+) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="voyza_notifications" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="grab" />
        </intent>
    </queries>
</manifest>